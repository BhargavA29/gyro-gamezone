# Server listen port (Render / Koyeb / Railway inject PORT automatically)
PORT=2567

# Comma-separated frontend origins allowed for CORS (e.g. https://gyro-gamezone.vercel.app)
# Leave * to allow any origin including Vercel preview URLs
ALLOWED_ORIGINS=*

# Set to 1 to also serve apps/play/dist from this Node server (single-host mode)
SERVE_PLAY_DIST=0
